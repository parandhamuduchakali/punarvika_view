# Angular specific
/dist/
/out-tsc/
/tmp/
/coverage/
/e2e/test-output/
/.angular/
.angular/

# Node modules and dependency files
/node_modules/
# package-lock.json is deliberately NOT ignored: without it `npm install` can
# resolve different transitive versions than were tested, so a build that works
# here is not the build that ships. yarn.lock stays ignored because this project
# uses npm.
/yarn.lock

# Environment files
/.env

# Angular CLI and build artefacts
/.angular-cli.json
/.ng/

# TypeScript cache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
